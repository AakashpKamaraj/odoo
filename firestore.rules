rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document or matches email
    function isOwner(email) {
      return isAuthenticated() && (request.auth.token.email == email || request.auth.uid == email);
    }

    // Users Collection: Public read for internal directory; write allowed for auth user or admin
    match /users/{userId} {
      allow read: if true;
      allow write: if true; // Allows demo users and registered users to save profiles
    }

    // Tasks Collection: Read and write for active workspace users
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Leaves Collection: Read and write for leave submissions and HR approvals
    match /leaves/{leaveId} {
      allow read, write: if true;
    }

    // Attendance Collection
    match /attendance/{recordId} {
      allow read, write: if true;
    }

    // Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
